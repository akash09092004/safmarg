                  "  pm.collectionVariables.set('bookingId', r.data.id);",
                  "  pm.collectionVariables.set('pnr', r.data.pnr);",
                  "  if (r.data.passengers?.length) pm.collectionVariables.set('passengerId', r.data.passengers[0].id);",
                  "}"
                ]
              }
            }
