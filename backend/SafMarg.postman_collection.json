            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight_id\": \"{{flightId}}\",\n  \"contact_email\": \"aman@example.com\",\n  \"contact_phone\": \"+919876543210\",\n  \"passengers\": [\n    {\n      \"seat_id\": \"{{seatId}}\",\n      \"first_name\": \"Aman\",\n      \"last_name\": \"Kumar\",\n      \"gender\": \"male\",\n      \"date_of_birth\": \"1998-05-10\",\n      \"passport_number\": \"P1234567\",\n      \"nationality\": \"Indian\"\n    }\n  ]\n}",
